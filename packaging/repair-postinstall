#!/bin/bash
set -e

# repair-postinstall — runs as root via system_installd when immurok_repair.pkg
# is installed. Unlike `osascript ... with administrator privileges` (whose root
# is TCC-blocked from writing /etc/pam.d), the installer daemon holds the
# com.apple.rootless.install entitlement and CAN write there. Mirrors the
# insertion half of packaging/postinstall; idempotently re-adds the immurok PAM
# line that a macOS upgrade strips from /etc/pam.d/authorization.
#
# IMMUROK_ROOT prefixes all paths for the bash test harness; empty in production.

R="${IMMUROK_ROOT:-}"
SO_FILE="${R}/usr/local/lib/pam/pam_immurok.so"
AUTH="${R}/etc/pam.d/authorization"
SUDO_LOCAL="${R}/etc/pam.d/sudo_local"
SUDO_FILE="${R}/etc/pam.d/sudo"
CONFIG_LINE="auth sufficient /usr/local/lib/pam/pam_immurok.so"
# IMMUROK_OS_MAJOR overrides sw_vers for the test harness.
OS_MAJOR="${IMMUROK_OS_MAJOR:-$(sw_vers -productVersion | cut -d. -f1)}"

# Guard: the .so must already be installed. If it's gone the user fully
# uninstalled — repairing the pam.d line would point at a missing module.
if [ ! -f "$SO_FILE" ]; then
    echo "ERROR: $SO_FILE not found — reinstall immurok instead of repairing" >&2
    exit 1
fi

# ---- 备份 / 检查写入 / 失败恢复 ----
# macOS 27 起 /etc/pam.d 受 TCC 保护，用户在「"Installer" would like to administer
# your computer」点 Don't Allow 时写入返回 Operation not permitted。任一步失败：
# 恢复已改动的文件、删掉本次新建的文件，exit 1 让 Installer 如实报失败。
PAMD="${R}/etc/pam.d"
BACKUP="$(mktemp -d)"
CREATED=""

backup_file() {   # $1=目标；不存在则记为新建
    if [ -f "$1" ]; then
        cp -p "$1" "$BACKUP/$(basename "$1")"
    else
        CREATED="$CREATED $1"
    fi
}
write_file() {    # $1=临时文件 $2=目标；任一步失败返回非 0
    cp "$1" "$2" && chmod 444 "$2"
}
# 恢复备份。被拒时 unlink 同样会被 TCC 拒，所以：内容未变的文件不碰；
# 先原地覆盖（root 对 444 文件可直接写），失败才退回 rm+cp；每一步都不能让
# set -e 半路退出，否则到不了约定的退出码与日志行。
restore_all() {
    local f dest
    for f in "$BACKUP"/*; do
        [ -e "$f" ] || continue
        dest="$PAMD/$(basename "$f")"
        if ! cmp -s "$f" "$dest"; then
            cp -p "$f" "$dest" 2>/dev/null \
                || { rm -f "$dest" 2>/dev/null && cp -p "$f" "$dest" 2>/dev/null; } \
                || echo "immurok: failed to restore $dest" >&2
        fi
    done
    for f in $CREATED; do rm -f "$f" 2>/dev/null || true; done
}
abort_denied() {  # $1=临时文件（可空）
    [ -n "${1:-}" ] && rm -f "$1"
    restore_all
    rm -rf "$BACKUP"
    echo "immurok: /etc/pam.d write denied (TCC), repair aborted" >&2
    exit 1
}

# authorization: prepend the line if absent. Anchored match so a commented-out
# reference doesn't count as present. Temp file in /tmp, then overwrite the
# existing file (system_installd is permitted to write /etc/pam.d).
if ! grep -qE '^[^#]*pam_immurok' "$AUTH" 2>/dev/null; then
    backup_file "$AUTH"
    TMP=$(mktemp)
    echo "$CONFIG_LINE" > "$TMP"
    [ -f "$AUTH" ] && cat "$AUTH" >> "$TMP"
    write_file "$TMP" "$AUTH" || abort_denied "$TMP"
    rm -f "$TMP"
fi

# sudo_local: idempotent top-up. It survives upgrades, but repairing it too is
# cheap insurance against partial resets.
if ! grep -qE '^[^#]*pam_immurok' "$SUDO_LOCAL" 2>/dev/null; then
    backup_file "$SUDO_LOCAL"
    TMP=$(mktemp)
    echo "$CONFIG_LINE" > "$TMP"
    [ -f "$SUDO_LOCAL" ] && cat "$SUDO_LOCAL" >> "$TMP"
    write_file "$TMP" "$SUDO_LOCAL" || abort_denied "$TMP"
    rm -f "$TMP"
fi

# macOS 13 Ventura and earlier: sudo doesn't include sudo_local, the line must
# live in /etc/pam.d/sudo itself — and every macOS update strips it. This is
# the primary repair target on 13.x. Never create the file from scratch: a
# sudo file with only our line (missing pam_opendirectory) would break sudo.
if [ "$OS_MAJOR" -lt 14 ] 2>/dev/null; then
    if [ -f "$SUDO_FILE" ]; then
        if ! grep -qE '^[^#]*pam_immurok' "$SUDO_FILE"; then
            backup_file "$SUDO_FILE"
            TMP=$(mktemp)
            echo "$CONFIG_LINE" > "$TMP"
            cat "$SUDO_FILE" >> "$TMP"
            write_file "$TMP" "$SUDO_FILE" || abort_denied "$TMP"
            rm -f "$TMP"
        fi
    else
        echo "WARN: $SUDO_FILE missing — skipped (would break sudo if created bare)" >&2
    fi
fi

rm -rf "$BACKUP"
exit 0
